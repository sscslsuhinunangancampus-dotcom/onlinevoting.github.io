# Copy to .env and replace every example value before deployment.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:change_me@localhost:5432/fairvote
SESSION_SECRET=replace_with_at_least_32_random_bytes
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
# Set this to the campus timezone, e.g. Asia/Manila
VOTING_TIME_ZONE=Asia/Manila
VOTING_START=2026-10-11T00:00:00+08:00
VOTING_END=2026-10-31T23:59:59+08:00
